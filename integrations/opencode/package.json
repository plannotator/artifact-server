{
  "name": "@artifact-server/opencode-extension",
  "version": "0.0.0",
  "description": "OpenCode plugin bridge for Artifact Server: receives annotation bundles as follow-up prompts and closes them through the comment API.",
  "type": "module",
  "keywords": [
    "opencode-plugin",
    "artifact-server"
  ],
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@plannotator/agent-bridge": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
