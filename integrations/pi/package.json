{
  "name": "@artifact-server/pi-extension",
  "version": "0.0.0",
  "description": "Pi coding-agent bridge for Artifact Server: receives annotation bundles as follow-up work and closes them through the comment API.",
  "type": "module",
  "keywords": [
    "pi-package",
    "artifact-server"
  ],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "files": [
    "index.ts",
    "bridge-core.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  }
}
