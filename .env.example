# Optional WorkOS AuthKit browser login. Use an Artifact Server-specific WorkOS
# environment. Do not reuse a Plannotator Workspaces staging or production environment.
ARTIFACT_SERVER_BOOTSTRAP_ADMIN_EMAIL=ramos@plannotator.ai
ARTIFACT_SERVER_ORIGIN=https://artifactserver.example
# ARTIFACT_SERVER_WORKOS_CLIENT_ID=client_replace_me
# ARTIFACT_SERVER_WORKOS_API_KEY=sk_replace_me
# ARTIFACT_SERVER_WORKOS_API_KEY_FILE=/run/secrets/workos-api-key

# External-storage runtime. The bucket must already exist. Leave endpoint unset for
# AWS S3; set it and force path style only for a compatible provider that needs it.
ARTIFACT_SERVER_API_TOKEN=replace_with_at_least_32_random_characters
# ARTIFACT_SERVER_API_TOKEN_FILE=/run/secrets/artifact-server-api-token
ARTIFACT_SERVER_DATABASE_URL=postgresql://artifactserver:replace_me@postgres.example/artifactserver
# ARTIFACT_SERVER_DATABASE_URL_FILE=/run/secrets/database-url
ARTIFACT_SERVER_INSTALLATION_ID=replace_with_stable_installation_id
ARTIFACT_SERVER_CONTENT_DOMAIN=content.example.net
ARTIFACT_SERVER_OBJECT_STORAGE_PROVIDER=s3
# Omit both S3 credential values to use the AWS SDK workload-identity chain.
ARTIFACT_SERVER_S3_ACCESS_KEY_ID=replace_me
# ARTIFACT_SERVER_S3_ACCESS_KEY_ID_FILE=/run/secrets/s3-access-key-id
ARTIFACT_SERVER_S3_SECRET_ACCESS_KEY=replace_me
# ARTIFACT_SERVER_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3-secret-access-key
ARTIFACT_SERVER_S3_BUCKET=artifact-server
ARTIFACT_SERVER_S3_REGION=us-east-1
ARTIFACT_SERVER_S3_FORCE_PATH_STYLE=false
# ARTIFACT_SERVER_S3_ENDPOINT=https://s3-compatible.example

# Google Cloud Storage alternative. Artifact Server uses Application Default
# Credentials; do not set S3 credentials when this provider is selected.
# ARTIFACT_SERVER_OBJECT_STORAGE_PROVIDER=gcs
# ARTIFACT_SERVER_GCS_PROJECT_ID=artifact-server-production
# ARTIFACT_SERVER_GCS_BUCKET=artifact-server-production-artifacts

# Azure Blob alternative. Artifact Server uses DefaultAzureCredential so a
# deployed service should receive a managed identity, not a storage key.
# ARTIFACT_SERVER_OBJECT_STORAGE_PROVIDER=azure-blob
# ARTIFACT_SERVER_AZURE_BLOB_ACCOUNT_URL=https://replace.blob.core.windows.net
# ARTIFACT_SERVER_AZURE_BLOB_CONTAINER=artifacts
# Optional browser bootstrap for a private or development external-storage installation.
# ARTIFACT_SERVER_LOCAL_BOOTSTRAP_TOKEN=replace_with_at_least_32_random_characters
# ARTIFACT_SERVER_LOCAL_BOOTSTRAP_TOKEN_FILE=/run/secrets/local-bootstrap-token

# Graceful shutdown. Readiness changes to draining before the listener closes.
# ARTIFACT_SERVER_READINESS_WITHDRAWAL_MS=1000
# ARTIFACT_SERVER_SHUTDOWN_DEADLINE_MS=10000

# Optional OpenTelemetry export. Artifact Server writes sampled structured JSON
# request logs in deployed processes. Errors and requests taking at least one
# second are always logged. Set 0 to disable normal access logs, or 1 to log all.
# ARTIFACT_SERVER_REQUEST_LOG_SAMPLE_RATE=0.01
# Set these to also export logs, metrics, and traces to an OTLP/HTTP collector.
# Signal-specific OTEL endpoint and header variables are also supported by
# Effect's standard OpenTelemetry configuration.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_LOGS_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_TRACES_EXPORTER=otlp
