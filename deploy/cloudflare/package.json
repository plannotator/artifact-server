{
  "name": "@artifact-server/cloudflare-deployment",
  "version": "0.0.0",
  "private": true,
  "description": "Pinned Alchemy deployment project for Artifact Server on Cloudflare.",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "lint": "oxlint --config ./.oxlintrc.json --type-aware --type-check --deny-warnings .",
    "plan": "alchemy plan",
    "probe:account": "node ./scripts/account-probe.mjs",
    "pretest": "pnpm --dir ../.. --filter @artifact-server/web build",
    "recovery:coordinated": "node ./scripts/coordinated-recovery.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "alchemy": "2.0.0-beta.79",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@effect/platform-node": "4.1.2",
    "@types/node": "26.6.6",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.156.1"
  }
}
