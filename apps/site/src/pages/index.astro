---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import ArtifactMark from "../components/ArtifactMark.astro";
import Header from "../components/Header.astro";
import LandingShapes from "../components/LandingShapes.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { repositoryUrl } from "../lib/public-config";
import claudeLogo from "../../../web/src/review/assets/agents/claude.svg";
import codexDark from "../../../web/src/review/assets/agents/codex-dark.svg";
import codexLight from "../../../web/src/review/assets/agents/codex-light.svg";
import copilotDark from "../../../web/src/review/assets/agents/copilot-dark.svg";
import copilotLight from "../../../web/src/review/assets/agents/copilot-light.svg";
import cursorDark from "../../../web/src/review/assets/agents/cursor-dark.svg";
import cursorLight from "../../../web/src/review/assets/agents/cursor-light.svg";
import opencodeDark from "../../../web/src/review/assets/agents/opencode-dark.svg";
import opencodeLight from "../../../web/src/review/assets/agents/opencode-light.svg";
import piDark from "../../../web/src/review/assets/agents/pi.svg";
import piLight from "../../../web/src/review/assets/agents/pi-light.svg";
import plannotatorBadge from "../../../../docs/images/star-plannotator.svg";
import workspacesBadge from "../../../../docs/images/plannotator-workspaces.svg";
import "../styles/landing.css";

const description = "The open-source, self-hostable alternative to Claude Code artifacts. One place for people and agents to publish, review, comment on, version, and share the artifacts they create while building products.";

// Each agent carries a light- and dark-theme mark; CSS shows the one that
// matches `[data-mode]` so single-color marks stay visible on both grounds.
const agents = [
  { name: "Claude Code", tier: "channel", light: claudeLogo.src, dark: claudeLogo.src },
  { name: "Codex", tier: "mailbox", light: codexLight.src, dark: codexDark.src },
  { name: "Cursor", tier: "mailbox", light: cursorLight.src, dark: cursorDark.src },
  { name: "GitHub Copilot", tier: "mailbox", light: copilotLight.src, dark: copilotDark.src },
  { name: "Pi", tier: "native", light: piLight.src, dark: piDark.src },
  { name: "OpenCode", tier: "native", light: opencodeLight.src, dark: opencodeDark.src },
];
---

<BaseLayout title="Artifact Server — open-source Claude Code artifacts" description={description} markdownUrl="/index.md">
  <div class="landing-shell">
    <LandingShapes />
    <Header showSidebar={false} />
    <main id="main-content" tabindex="-1">
      <section class="landing-hero" aria-labelledby="landing-title">
        <div class="landing-hero__copy">
          <p class="landing-eyebrow">
            <span></span>
            Open source · self-hostable
          </p>
          <h1 id="landing-title">Open-source Claude&nbsp;Code artifacts.</h1>
          <a class="landing-byline" href="https://plannotator.ai">
            <span>by</span> Plannotator
            <Icon name="ph:arrow-up-right" />
          </a>
          <p class="landing-lede">
            The self-hostable alternative to Claude Code artifacts. Artifact Server gives
            people and agents one place to publish, review, comment on, version, and
            share the artifacts they create while building products. Its built-in MCP
            server gives agents direct access to the same work.
          </p>
          <div class="landing-actions">
            <a class="landing-button landing-button--primary" href="/docs/get-started/">
              Run it locally
              <Icon name="ph:arrow-right" />
            </a>
            <a class="landing-button" href="/docs/deploy/">
              Deploy for a team
              <Icon name="ph:cloud-arrow-up" />
            </a>
          </div>
          <div class="landing-commands" aria-label="Install commands">
            <p>
              <code>artifactserver connect</code>
              <a href="/docs/mcp/">connect your agent</a>
              <button type="button" data-copy="artifactserver connect" aria-label="Copy the connect command">
                <Icon name="ph:copy" /><Icon name="ph:check" />
              </button>
            </p>
            <p>
              <code>npx skills add plannotator/artifact-server</code>
              <a href="/docs/mcp/#install-the-artifact-server-skill">install the skill</a>
              <button type="button" data-copy="npx skills add plannotator/artifact-server" aria-label="Copy the skill install command">
                <Icon name="ph:copy" /><Icon name="ph:check" />
              </button>
            </p>
          </div>
        </div>

        <figure class="artifact-window" aria-label="Artifact Server review: the artifact fills the canvas with the comment panel open beside it, showing two reviewers and a connected Pi agent">
          <div class="artifact-window__body">
            <div class="artifact-canvas">
              <div class="artifact-document">
                <p>RELEASE 04 · READY FOR REVIEW</p>
                <h2>Dev work worth keeping.</h2>
                <span></span><span></span><span></span>
                <div class="artifact-collage" aria-hidden="true">
                  <i class="collage collage--image">
                    <svg viewBox="0 0 52 40" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="48" height="36" /><circle cx="16" cy="14" r="4" /><path d="M2 32l14-12 10 8 8-6 16 12" /></svg>
                  </i>
                  <i class="collage collage--video">
                    <svg viewBox="0 0 52 40" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="48" height="36" /><path d="M21 13l12 7-12 7z" fill="currentColor" stroke="none" /></svg>
                  </i>
                  <i class="collage collage--puzzle">
                    <svg viewBox="0 0 48 48" fill="currentColor"><path d="M6 12h10c0-6 12-6 12 0h10v10c6 0 6 12 0 12v10H6z" /></svg>
                  </i>
                  <i class="collage collage--image collage--alt">
                    <svg viewBox="0 0 52 40" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="48" height="36" /><circle cx="36" cy="14" r="4" /><path d="M2 34l18-16 12 10 6-5 12 11" /></svg>
                  </i>
                  <i class="collage collage--video collage--alt">
                    <svg viewBox="0 0 52 40" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="48" height="36" /><path d="M21 13l12 7-12 7z" fill="currentColor" stroke="none" /></svg>
                  </i>
                  <i class="collage collage--puzzle collage--alt">
                    <svg viewBox="0 0 48 48" fill="currentColor"><path d="M6 12h10c0-6 12-6 12 0h10v10c6 0 6 12 0 12v10H6z" /></svg>
                  </i>
                </div>
                <span></span><span></span>
              </div>
            </div>
            <div class="artifact-inspector">
              <header class="artifact-inspector__people">
                <span class="avatar-stack" aria-label="Pi agent, Ada Lovelace, and Sam Kim are in this review">
                  <i class="human-avatar" title="Ada Lovelace">AL</i>
                  <i class="human-avatar" title="Sam Kim">SK</i>
                  <i class="loop-presence" title="Pi · idle"><img alt="" src={piLight.src} class="theme-light" /><img alt="" src={piDark.src} class="theme-dark" /></i>
                </span>
                <b>Comments <span>3</span></b>
              </header>
              <article>
                <header><i>1</i><strong>Keep this tied to the exact version.</strong></header>
                <p>The new explanation is clear. The diagram should name the content boundary too.</p>
                <footer><span><i class="human-avatar human-avatar--xs">SK</i> Sam Kim</span><button type="button" tabindex="-1">Reply</button></footer>
              </article>
              <article>
                <header><i>2</i><strong>Ready for the agent.</strong></header>
                <p>Send this thread with the artifact context and let it close the loop.</p>
                <footer><span><i class="human-avatar human-avatar--xs">AL</i> Ada Lovelace</span><button type="button" tabindex="-1">Reply</button></footer>
              </article>
              <article>
                <header><i>3</i><strong>Swap the hero image for the new render.</strong></header>
                <p>The one in v3 is the old palette.</p>
                <footer><span><i class="human-avatar human-avatar--xs">SK</i> Sam Kim</span><button type="button" tabindex="-1">Reply</button></footer>
              </article>
              <div class="artifact-inspector__send">
                <button type="button" tabindex="-1">Send all open (3) to Pi</button>
              </div>
            </div>
          </div>
        </figure>
      </section>

      <section class="landing-principles" id="how-it-works" aria-labelledby="principles-title">
        <header class="landing-section-heading">
          <p>Why Artifact Server</p>
          <div>
            <h2 id="principles-title">Keep the work your team makes, not just the code.</h2>
            <p class="landing-section-lede">
              Teams now use HTML, images, and video for plans, mockups, prototypes, code
              reviews, and other work created during product development. That work
              quickly becomes disorganized, and providers try to lock it inside their
              platforms. Artifact Server gives teams a self-hosted place to organize and
              collaborate on it, and to keep control of the files and data.
            </p>
          </div>
        </header>
        <div class="landing-principle-grid">
          <article>
            <span>01</span>
            <Icon name="ph:upload-simple" />
            <h3>Publish from where the work happens.</h3>
            <p>Agents publish through MCP or the Agent Skill; people use the CLI or the browser. Complete files or whole sites, one verified upload.</p>
            <code>/artifact-server upload that HTML design doc</code>
          </article>
          <article>
            <span>02</span>
            <Icon name="ph:stack" />
            <h3>Keep immutable versions.</h3>
            <p>Every save creates a version with stable bytes and identity, organized by project. The artifact link moves; history does not.</p>
            <code>Project → Artifact → Version</code>
          </article>
          <article>
            <span>03</span>
            <Icon name="ph:chat-centered-text" />
            <h3>Review, comment, share.</h3>
            <p>Comments stay attached to the exact version and target. Share a review link, not a file path, and the next change starts with real context.</p>
            <code>Comment → Agent → New version</code>
          </article>
        </div>
      </section>

      <section class="landing-loop" id="agents" aria-labelledby="loop-title">
        <div class="landing-loop__copy">
          <p class="landing-eyebrow"><span></span>Built for AI agents</p>
          <h2 id="loop-title">Comment. Send all. The agent closes every thread.</h2>
          <p>
            Every agent that speaks MCP can publish, organize, review, comment on, and
            share versioned artifacts through the built-in MCP server. Connect Pi,
            OpenCode, or Claude Code as a live agent and it appears in the review with a
            presence avatar: one click sends every open comment into its running session,
            and it replies, resolves, and publishes the next version. Nothing gets pasted
            into a chat.
          </p>
          <ul class="landing-loop__agents" aria-label="Supported agents">
            {agents.map((agent) => (
              <li title={`${agent.name} · ${agent.tier}`}>
                <img alt="" src={agent.light} class="theme-light" />
                <img alt="" src={agent.dark} class="theme-dark" />
                <span>{agent.name}</span>
              </li>
            ))}
          </ul>
          <a href="/docs/agents/">Connect a coding agent <Icon name="ph:arrow-right" /></a>
        </div>
        <figure class="loop-panel" aria-label="Comments panel with a connected Pi agent and the send-all control">
          <figcaption>
            <b>Comments <span>3</span></b>
            <span class="loop-panel__presence" title="Pi · replying">
              <i class="loop-presence loop-presence--replying"><img alt="" src={piLight.src} class="theme-light" /><img alt="" src={piDark.src} class="theme-dark" /></i>
              Pi · replying
            </span>
          </figcaption>
          <div class="loop-panel__send">
            <button type="button" tabindex="-1">
              Send all open (3) to Pi
            </button>
            <button type="button" tabindex="-1" aria-label="Choose another agent"><Icon name="ph:caret-down" /></button>
          </div>
          <article>
            <header><i>1</i><strong>Name the content boundary in the diagram.</strong></header>
            <p class="loop-panel__reply"><img alt="" src={piLight.src} class="theme-light" /><img alt="" src={piDark.src} class="theme-dark" /> Added the isolated content origin to the diagram and the caption. Resolved.</p>
          </article>
          <article>
            <header><i>2</i><strong>The install command is stale.</strong></header>
            <p class="loop-panel__reply"><img alt="" src={piLight.src} class="theme-light" /><img alt="" src={piDark.src} class="theme-dark" /> Updated to the current command in both places. Resolved.</p>
          </article>
          <article class="loop-panel__open">
            <header><i>3</i><strong>Tighten the second paragraph.</strong></header>
            <p>Sent · replying…</p>
          </article>
        </figure>
      </section>

      <section class="landing-boundary" aria-labelledby="boundary-title">
        <div class="landing-boundary__copy">
          <p class="landing-eyebrow"><span></span>Security model</p>
          <h2 id="boundary-title">The artifact gets the canvas. The application keeps control.</h2>
          <p>
            Untrusted artifact content is served from isolated version hosts, separate
            from the trusted application origin that owns authentication, review,
            comments, the API, and MCP. Private content uses version-scoped browser
            sessions, and untrusted paths never select storage locations.
          </p>
          <a href="/docs/concepts/security-boundary/">Understand the two-origin model <Icon name="ph:arrow-right" /></a>
        </div>
        <div class="boundary-diagram" role="img" aria-label="Trusted Artifact Server application connected to an isolated artifact content origin">
          <article>
            <small>TRUSTED ORIGIN</small>
            <strong>Artifact Server</strong>
            <span>Identity · versions · comments · MCP</span>
          </article>
          <div><span>exact version</span><i></i><span>sandboxed view</span></div>
          <article>
            <small>CONTENT ORIGIN</small>
            <strong>Your artifact</strong>
            <span>HTML · images · video</span>
          </article>
        </div>
      </section>

      <section class="landing-deploy" aria-labelledby="deploy-title">
        <header class="landing-section-heading">
          <p>Yours to run</p>
          <h2 id="deploy-title">Run it on a laptop. Deploy it for a team.</h2>
        </header>
        <div class="landing-deploy__grid">
          <article>
            <Icon name="ph:laptop" />
            <h3>Local</h3>
            <p>Loopback-only owner access with no sign-in ceremony. SQLite and files on disk, directly on your machine.</p>
            <code>git clone … && pnpm dev</code>
          </article>
          <article>
            <Icon name="ph:cloud" />
            <h3>Cloudflare</h3>
            <p>The main hosted target: Workers, D1, and R2 with private team authentication and isolated content domains.</p>
            <code>Workers · D1 · R2</code>
            <a
              class="landing-cloudflare-artifacts"
              href="https://developers.cloudflare.com/artifacts/"
              target="_blank"
              rel="noreferrer"
            >
              <span class="landing-cloudflare-artifacts__mark" aria-hidden="true"></span>
              <span class="landing-cloudflare-artifacts__label">
                <small>In partnership with</small>
                <span>
                  <strong>Cloudflare Artifacts</strong>
                  <em>Closed beta</em>
                </span>
              </span>
              <Icon name="ph:arrow-up-right" aria-hidden="true" />
            </a>
          </article>
          <article>
            <Icon name="ph:buildings" />
            <h3>Your infrastructure</h3>
            <p>Docker Compose, Kubernetes with Helm, AWS with ECS and RDS, or Google Cloud with Cloud Run and Cloud SQL. Product behavior stays independent of the provider.</p>
            <code>Compose · Kubernetes · AWS · Google Cloud</code>
          </article>
        </div>
        <div class="landing-deploy__cta">
          <div>
            <span>Every remote deployment uses one trusted application origin and one isolated wildcard content domain.</span>
            <p>The deployment guide covers shared requirements, storage choices, authentication, and backups.</p>
          </div>
          <a class="landing-button" href="/docs/deploy/">Choose a deployment <Icon name="ph:arrow-right" /></a>
        </div>
      </section>

      <section class="landing-close" aria-labelledby="close-title">
        <ArtifactMark />
        <p>Get started</p>
        <h2 id="close-title">Your work, your artifacts.</h2>
        <div class="landing-actions">
          <a class="landing-button landing-button--primary" href="/docs/get-started/">Get started locally <Icon name="ph:arrow-right" /></a>
          <a class="landing-button" href={repositoryUrl}><Icon name="ph:star" /> Star on GitHub <Icon name="ph:arrow-up-right" /></a>
        </div>
        <div class="landing-badges">
          <a href="https://github.com/backnotprop/plannotator"><img src={plannotatorBadge.src} alt="Artifact Server is created with Plannotator" width="395" height="60" /></a>
          <a href="https://plannotator.ai/workspaces"><img src={workspacesBadge.src} alt="Plannotator Workspaces is the planning layer for your software factory" width="395" height="60" /></a>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<script>
  // Copy buttons on the hero commands. Progressive: without clipboard access
  // the button does nothing and the command text is still selectable.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const text = button.dataset.copy ?? "";
      try {
        await navigator.clipboard.writeText(text);
        button.dataset.copied = "true";
        window.setTimeout(() => {
          delete button.dataset.copied;
        }, 1600);
      } catch {
        // Clipboard unavailable (insecure context or permission denied).
      }
    });
  }
</script>
