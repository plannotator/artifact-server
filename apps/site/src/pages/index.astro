---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import ArtifactMark from "../components/ArtifactMark.astro";
import Header from "../components/Header.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { artifactServerAppUrl } from "../lib/public-config";
import claudeLogo from "../../../web/src/review/assets/agents/claude.svg";
import codexDark from "../../../web/src/review/assets/agents/codex-dark.svg";
import codexLight from "../../../web/src/review/assets/agents/codex-light.svg";
import copilotDark from "../../../web/src/review/assets/agents/copilot-dark.svg";
import copilotLight from "../../../web/src/review/assets/agents/copilot-light.svg";
import cursorDark from "../../../web/src/review/assets/agents/cursor-dark.svg";
import cursorLight from "../../../web/src/review/assets/agents/cursor-light.svg";
import piDark from "../../../web/src/review/assets/agents/pi.svg";
import piLight from "../../../web/src/review/assets/agents/pi-light.svg";
import "../styles/landing.css";

// Each agent carries a light- and dark-theme mark; CSS shows the one that
// matches `[data-mode]` so single-color marks stay visible on both grounds.
const agents = [
  { name: "Pi", tier: "native", light: piLight.src, dark: piDark.src },
  { name: "Claude Code", tier: "channel", light: claudeLogo.src, dark: claudeLogo.src },
  { name: "Codex", tier: "mailbox", light: codexLight.src, dark: codexDark.src },
  { name: "Cursor", tier: "mailbox", light: cursorLight.src, dark: cursorDark.src },
  { name: "GitHub Copilot", tier: "mailbox", light: copilotLight.src, dark: copilotDark.src },
];

const description = "Publish the browser artifacts your agents make, keep every version, and review them with people and agents from one durable place.";
---

<BaseLayout title="Artifact Server — a durable home for agent-made work" description={description} markdownUrl="/index.md">
  <div class="landing-shell">
    <Header showSidebar={false} />
    <main id="main-content" tabindex="-1">
      <section class="landing-hero" aria-labelledby="landing-title">
        <div class="landing-hero__copy">
          <p class="landing-eyebrow">
            <span></span>
            Self-hostable · fair source
          </p>
          <h1 id="landing-title">Give every artifact a stable home.</h1>
          <p class="landing-lede">
            Publish the documents, prototypes, reports, and sites your agents make.
            Artifact Server keeps every version immutable, makes review precise, and
            gives people and agents the same source of truth.
          </p>
          <div class="landing-actions">
            <a class="landing-button landing-button--primary" href={artifactServerAppUrl}>
              Open Artifact Server
              <Icon name="ph:arrow-up-right" />
            </a>
            <a class="landing-button" href="/docs/">
              Read the docs
              <Icon name="ph:arrow-right" />
            </a>
          </div>
          <p class="landing-command" aria-label="Install command">
            <code>npx skills add plannotator/artifact-server</code>
            <span>CLI · MCP · HTTP</span>
          </p>
        </div>

        <figure class="artifact-window" aria-label="Artifact Server review showing an artifact, its immutable version, and review comments">
          <figcaption class="artifact-window__topbar">
            <span class="artifact-window__brand"><ArtifactMark /> Artifact Server</span>
            <span>Default project</span>
            <span class="artifact-window__status"><i></i> Local</span>
          </figcaption>
          <div class="artifact-window__body">
            <div class="artifact-catalog">
              <div class="artifact-search"><Icon name="ph:magnifying-glass" /> Search artifacts…</div>
              <article class="artifact-card artifact-card--active">
                <strong>Release narrative</strong>
                <span>documentation · product</span>
                <small>4 versions</small>
              </article>
              <article class="artifact-card">
                <strong>Checkout prototype</strong>
                <span>prototype · ui</span>
                <small>2 versions</small>
              </article>
              <article class="artifact-card">
                <strong>Performance report</strong>
                <span>report · benchmark</span>
                <small>8 versions</small>
              </article>
            </div>
            <div class="artifact-preview">
              <header>
                <div><strong>Release narrative</strong><span>Version 4 · immutable</span></div>
                <button type="button" tabindex="-1">Full screen</button>
              </header>
              <div class="artifact-preview__canvas">
                <div class="artifact-document">
                  <p>RELEASE 04 · READY FOR REVIEW</p>
                  <h2>A precise record of work worth keeping.</h2>
                  <span></span><span></span><span></span>
                  <aside>
                    <strong>Current state</strong>
                    <p>One version, five files, three open comments.</p>
                  </aside>
                </div>
              </div>
            </div>
            <div class="artifact-inspector">
              <nav><b>Comments <span>3</span></b><span>Details</span><span>Files</span></nav>
              <article>
                <header><i>1</i><strong>Keep this tied to the exact version.</strong></header>
                <p>The new explanation is clear. The diagram should name the content boundary too.</p>
                <footer><span>Sam</span><button type="button" tabindex="-1">Reply</button></footer>
              </article>
              <article>
                <header><i>2</i><strong>Ready for the agent.</strong></header>
                <p>Send this thread with the artifact context and let it close the loop.</p>
                <footer><span>Ada</span><button type="button" tabindex="-1">Reply</button></footer>
              </article>
            </div>
          </div>
        </figure>
      </section>

      <section class="landing-principles" id="how-it-works" aria-labelledby="principles-title">
        <header class="landing-section-heading">
          <p>One durable loop</p>
          <h2 id="principles-title">Publish, review, improve—without losing the work between.</h2>
        </header>
        <div class="landing-principle-grid">
          <article>
            <span>01</span>
            <Icon name="ph:upload-simple" />
            <h3>Publish from where the work happens.</h3>
            <p>Agents and developers publish complete files or sites through the CLI, MCP, or HTTP.</p>
            <code>artifactserver publish ./report.html</code>
          </article>
          <article>
            <span>02</span>
            <Icon name="ph:stack" />
            <h3>Keep immutable versions.</h3>
            <p>Every save creates a version with stable bytes and identity. The artifact link moves; history does not.</p>
            <code>Project → Artifact → Version</code>
          </article>
          <article>
            <span>03</span>
            <Icon name="ph:chat-centered-text" />
            <h3>Review with people and agents.</h3>
            <p>Comments stay attached to the exact version and target, so the next change starts with real context.</p>
            <code>Comment → Agent → New version</code>
          </article>
        </div>
      </section>

      <section class="landing-loop" id="agents" aria-labelledby="loop-title">
        <div class="landing-loop__copy">
          <p class="landing-eyebrow"><span></span>Live review with coding agents</p>
          <h2 id="loop-title">Comment. Send all. The agent closes every thread.</h2>
          <p>
            Connect Pi, OpenCode, or Claude Code and it appears in the review with a live
            presence avatar. One click sends every open comment on the version into its
            running session as follow-up work. It replies in each thread, resolves what it
            fixed, and publishes the next version. Nothing gets pasted into a chat.
          </p>
          <ul class="landing-loop__agents" aria-label="Supported agents">
            {agents.map((agent) => (
              <li title={`${agent.name} · ${agent.tier}`}>
                <img alt="" src={agent.light} class="theme-light" />
                <img alt="" src={agent.dark} class="theme-dark" />
                <span>{agent.name}</span>
              </li>
            ))}
          </ul>
          <a href="/docs/agents/">Connect a coding agent <Icon name="ph:arrow-right" /></a>
        </div>
        <figure class="loop-panel" aria-label="Comments panel with a connected Pi agent and the send-all control">
          <figcaption>
            <b>Comments <span>3</span></b>
            <span class="loop-panel__presence" title="Pi · replying">
              <i class="loop-presence loop-presence--replying"><img alt="" src={piLight.src} class="theme-light" /><img alt="" src={piDark.src} class="theme-dark" /></i>
              docs-site · replying
            </span>
          </figcaption>
          <div class="loop-panel__send">
            <button type="button" tabindex="-1">
              Send all open (3) to docs-site
            </button>
            <button type="button" tabindex="-1" aria-label="Choose another agent"><Icon name="ph:caret-down" /></button>
          </div>
          <article>
            <header><i>1</i><strong>Name the content boundary in the diagram.</strong></header>
            <p class="loop-panel__reply"><img alt="" src={piLight.src} class="theme-light" /><img alt="" src={piDark.src} class="theme-dark" /> Added the isolated content origin to the diagram and the caption. Resolved.</p>
          </article>
          <article>
            <header><i>2</i><strong>The install command is stale.</strong></header>
            <p class="loop-panel__reply"><img alt="" src={piLight.src} class="theme-light" /><img alt="" src={piDark.src} class="theme-dark" /> Updated to the current command in both places. Resolved.</p>
          </article>
          <article class="loop-panel__open">
            <header><i>3</i><strong>Tighten the second paragraph.</strong></header>
            <p>Sent · replying…</p>
          </article>
        </figure>
      </section>

      <section class="landing-boundary" aria-labelledby="boundary-title">
        <div class="landing-boundary__copy">
          <p class="landing-eyebrow"><span></span>Built around the trust boundary</p>
          <h2 id="boundary-title">The artifact gets the canvas. The application keeps control.</h2>
          <p>
            Finished HTML runs on an isolated content origin. The trusted review owns
            identity, comments, versions, and sharing. That separation gives rich artifacts
            the screen without giving untrusted content the keys.
          </p>
          <a href="/docs/concepts/security-boundary/">Understand the two-origin model <Icon name="ph:arrow-right" /></a>
        </div>
        <div class="boundary-diagram" role="img" aria-label="Trusted Artifact Server application connected to an isolated artifact content origin">
          <article>
            <small>TRUSTED ORIGIN</small>
            <strong>Artifact Server</strong>
            <span>Identity · versions · comments</span>
          </article>
          <div><span>exact version</span><i></i><span>sandboxed view</span></div>
          <article>
            <small>CONTENT ORIGIN</small>
            <strong>Your artifact</strong>
            <span>HTML · images · video</span>
          </article>
        </div>
      </section>

      <section class="landing-deploy" aria-labelledby="deploy-title">
        <header class="landing-section-heading">
          <p>Yours to run</p>
          <h2 id="deploy-title">Start on a laptop. Deploy the same product to your team.</h2>
        </header>
        <div class="landing-deploy__grid">
          <article>
            <Icon name="ph:laptop" />
            <h3>Local</h3>
            <p>Loopback-only owner access with no browser sign-in ceremony. SQLite and local files, directly on your machine.</p>
          </article>
          <article>
            <Icon name="ph:cloud" />
            <h3>Cloudflare</h3>
            <p>A first-class Worker deployment with D1, R2, private team authentication, and isolated content domains.</p>
          </article>
          <article>
            <Icon name="ph:buildings" />
            <h3>Your infrastructure</h3>
            <p>One server, Kubernetes, AWS, or GCP. Product behavior stays independent from the storage and deployment provider.</p>
          </article>
        </div>
        <div class="landing-deploy__cta">
          <div>
            <span>Cloudflare is the primary hosted target.</span>
            <p>Nimbus powers these docs; Workers, D1, and R2 power the deployment.</p>
          </div>
          <a class="landing-button" href="/docs/deploy/cloudflare/">Deploy on Cloudflare <Icon name="ph:arrow-right" /></a>
        </div>
      </section>

      <section class="landing-close" aria-labelledby="close-title">
        <ArtifactMark />
        <p>Artifacts are the product of the work.</p>
        <h2 id="close-title">Give them a home.</h2>
        <div class="landing-actions">
          <a class="landing-button landing-button--primary" href={artifactServerAppUrl}>Open Artifact Server <Icon name="ph:arrow-up-right" /></a>
          <a class="landing-button" href="/docs/get-started/">Get started locally <Icon name="ph:arrow-right" /></a>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
