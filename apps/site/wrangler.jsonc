{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artifact-server-site",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "artifactserver.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
