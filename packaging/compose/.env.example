# Use the immutable digest published for the release. A floating tag is not a
# supported production configuration.
ARTIFACT_SERVER_IMAGE=registry.example/artifact-server@sha256:replace_with_release_digest

# Loopback keeps the container port private to this server. A trusted reverse
# proxy or private-network gateway terminates TLS for the configured names.
ARTIFACT_SERVER_BIND_ADDRESS=127.0.0.1
ARTIFACT_SERVER_PORT=8787

# Private-team mode requires an HTTPS application origin and a separate
# registrable wildcard content domain routed by a trusted proxy.
ARTIFACT_SERVER_ORIGIN=https://artifacts.example.com
ARTIFACT_SERVER_CONTENT_DOMAIN=content.example.net

# Graceful shutdown and structured request logging.
ARTIFACT_SERVER_READINESS_WITHDRAWAL_MS=1000
ARTIFACT_SERVER_SHUTDOWN_DEADLINE_MS=10000
ARTIFACT_SERVER_REQUEST_LOG_SAMPLE_RATE=0.01

# Configure exactly one browser-login provider. For WorkOS, use a dedicated
# Artifact Server environment and uncomment all three values below.
# A file-backed API key also requires a small Compose override that mounts the
# named file read-only at ARTIFACT_SERVER_WORKOS_API_KEY_FILE.
# ARTIFACT_SERVER_WORKOS_CLIENT_ID=client_replace_me
# ARTIFACT_SERVER_WORKOS_ISSUER=https://replace-staging.authkit.app
# ARTIFACT_SERVER_WORKOS_API_KEY=sk_replace_me
# ARTIFACT_SERVER_WORKOS_API_KEY_FILE=/run/secrets/workos-api-key

# Generic OpenID Connect browser login for an installation that already runs
# its own identity provider. Configure WorkOS or OIDC, never both. The issuer
# must be an HTTPS URL with no query or fragment; plain http is allowed only for
# localhost, 127.0.0.1, and ::1. The client secret is optional. A file-backed
# client secret also requires a small Compose override that mounts the named file
# read-only at ARTIFACT_SERVER_OIDC_CLIENT_SECRET_FILE.
ARTIFACT_SERVER_OIDC_ISSUER=https://idp.example.com/realms/main
ARTIFACT_SERVER_OIDC_CLIENT_ID=artifact-server
# ARTIFACT_SERVER_OIDC_CLIENT_SECRET=replace_me
# ARTIFACT_SERVER_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
# ARTIFACT_SERVER_OIDC_SCOPES=openid email profile
