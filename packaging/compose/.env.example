# Use the immutable digest published for the release. A floating tag is not a
# supported production configuration.
ARTIFACT_SERVER_IMAGE=registry.example/artifact-server@sha256:replace_with_release_digest

# Loopback is the safe default. Change the bind address only when a trusted
# reverse proxy or private network should reach this service.
ARTIFACT_SERVER_BIND_ADDRESS=127.0.0.1
ARTIFACT_SERVER_PORT=8787

# The localhost pair needs no DNS, certificate, or reverse proxy. A server used
# from other devices needs an HTTPS application origin and a separate
# registrable wildcard content domain routed by a trusted proxy.
ARTIFACT_SERVER_ORIGIN=http://localhost:8787
ARTIFACT_SERVER_CONTENT_DOMAIN=localhost

# Graceful shutdown and structured request logging.
ARTIFACT_SERVER_READINESS_WITHDRAWAL_MS=1000
ARTIFACT_SERVER_SHUTDOWN_DEADLINE_MS=10000
ARTIFACT_SERVER_REQUEST_LOG_SAMPLE_RATE=0.01

# Optional WorkOS browser login. Use a dedicated Artifact Server environment.
# A file-backed API key also requires a small Compose override that mounts the
# named file read-only at ARTIFACT_SERVER_WORKOS_API_KEY_FILE.
# ARTIFACT_SERVER_WORKOS_CLIENT_ID=client_replace_me
# ARTIFACT_SERVER_WORKOS_API_KEY=sk_replace_me
# ARTIFACT_SERVER_WORKOS_API_KEY_FILE=/run/secrets/workos-api-key
